# Copy this file to `.env` and fill in real values. Do not commit `.env`.

# --- LINE Messaging API ---
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# --- NVIDIA Nemotron (build.nvidia.com) ---
# Get an API key at https://build.nvidia.com/
NVIDIA_API_KEY=
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
# Pick any Nemotron variant from build.nvidia.com. Default below is the
# strongest tier that still fits inside the free credit allowance for demos.
#   nvidia/nemotron-3-super-120b-a12b           ← default, NemoClaw-aligned
#   nvidia/llama-3.1-nemotron-70b-instruct      ← balanced, strong CN reasoning
#   nvidia/llama-3.1-nemotron-nano-8b-v1        ← lightweight, lowest credit burn
NEMOTRON_MODEL=nvidia/nemotron-3-super-120b-a12b

# --- Server ---
PORT=3000

# --- Scheduler ---
# Cron expression (Asia/Taipei). Default: every day at 09:00.
DAILY_SUMMARY_CRON="0 9 * * *"
DAILY_SUMMARY_TZ=Asia/Taipei
